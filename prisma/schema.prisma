generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
}

enum Sexe {
  HOMME
  FEMME
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  sexe      Sexe?
  image     String?
  role      Role     @default(CLIENT)
  isActif   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
} 